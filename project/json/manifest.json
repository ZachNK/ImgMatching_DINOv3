{
  "version": 2,
  "dataset_key": "shinsung_data",
  "weight_set": "dinov3_weights",
  "models": [
    {
      "weight_key": ["vitl16"],
      "image_groups": [
        {
          "altitudes": [250],
          "indices": [
            1
          ]
        }
      ],
      "token_jobs": [
        {
          "token_type": "GlobalToken",
          "variant": "raw",
          "variant_params": {},
          "target_res": 1024,
          "outputs": {
            "global": { "npy": true, "json": true }
          },
          "run": {
            "test_embedding": false
          }
        },
        {
          "token_type": "PatchToken",
          "variant": "raw",
          "variant_params": {},
          "target_res": 1024,
          "outputs": {
            "patch": { "npy": true, "json": true }
          },
          "run": {
            "test_embedding": false
          }
        },
        {
          "token_type": "PatchGrid",
          "variant": "raw",
          "variant_params": {},
          "target_res": 1024,
          "outputs": {
            "grid": { "npy": true, "json": true }
          },
          "run": {
            "test_embedding": false,
            "generate_denseft": true
          }
        }
      ]
    }
  ]
}
