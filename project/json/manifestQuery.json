{
  "version": 1,
  "dataset_key": "shinsung_data",
  "weight_set": "dinov3_weights",
  "query_embed_root": "/exports/dinov3_query_embeds",
  "models": [
    {
      "weight_key": ["vitl16"],
      "image_groups": [
        {
          "altitudes": [200, 300, 400],
          "indices": [
            3
          ],
          "rotation": [45, 90, 135, 180]
        }
      ],
      "token_jobs": [
        {
          "token_type": "GlobalToken",
          "variant": "raw",
          "variant_params": {},
          "target_res": 1024,
          "outputs": {
            "global": { "npy": true, "json": true }
          },
          "run": { "test_embedding": true }
        },
        {
          "token_type": "PatchToken",
          "variant": "raw",
          "variant_params": {},
          "target_res": 1024,
          "outputs": {
            "patch": { "npy": true, "json": true }
          },
          "run": { "test_embedding": true }
        },
        {
          "token_type": "PatchGrid",
          "variant": "raw",
          "variant_params": {},
          "target_res": 1024,
          "outputs": {
            "grid": { "npy": true, "json": true }
          },
          "run": {
            "test_embedding": true,
            "generate_denseft": true
          }
        }
      ]
    }
  ]
}
