{
  "dataset_key": "shinsung_data",
  "weight_set": "dinov3_weights",
  "query_embed_root": "/exports/dinov3_query_embeds",
  "experiment": {
    "variant": {
      "raw": false,
      "sub": { "use": true, "stride": [8] },
      "pca": { "use": false, "dim": [3, 16, 64] }
    },
    "pca_basis": "",
    "topk": {
      "use": true,
      "ratio": [0.01, 0.05, 0.1],
      "k": null
    }
  },
  "models": [
    {
      "weights": ["vits16+"],
      "target_res": 1024,
      "embedding_cfg": null,
      "image_groups": [
        {
          "altitudes": [100],
          "indices": [1, 10],
          "rotation": [45, 90, 135, 180]
        }
      ],
      "outputs": {
        "global": { "npy": true, "json": true },
        "patch":  { "npy": true, "json": true },
        "grid":   { "npy": true, "json": true }
      },
      "run": {
        "test_embedding": true,
        "generate_denseft": true
      }
    }
  ]
}
